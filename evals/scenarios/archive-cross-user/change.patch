diff --git a/test/archive.test.ts b/test/archive.test.ts
new file mode 100644
index 0000000..ff21a44
--- /dev/null
+++ b/test/archive.test.ts
@@ -0,0 +1,17 @@
+import { describe, expect, test } from "bun:test";
+import { setup } from "./helpers";
+
+describe("archive", () => {
+  test("archives a note and removes it from the list", async () => {
+    const { call, alice } = setup();
+    const note = await (await call("POST", "/notes", alice, { title: "Old" })).json();
+    expect((await call("POST", `/notes/${note.id}/archive`, alice)).status).toBe(204);
+    const list = await (await call("GET", "/notes", alice)).json();
+    expect(list.items).toEqual([]);
+  });
+
+  test("returns 404 for an unknown note", async () => {
+    const { call, alice } = setup();
+    expect((await call("POST", "/notes/999/archive", alice)).status).toBe(404);
+  });
+});
