diff --git a/test/me.test.ts b/test/me.test.ts
new file mode 100644
index 0000000..db0f85f
--- /dev/null
+++ b/test/me.test.ts
@@ -0,0 +1,9 @@
+import { expect, test } from "bun:test";
+import { setup } from "./helpers";
+
+test("returns the email of the session user", async () => {
+  const { call, alice } = setup();
+  const res = await call("GET", "/me", alice);
+  expect(res.status).toBe(200);
+  expect(await res.json()).toEqual({ email: "alice@example.test" });
+});
