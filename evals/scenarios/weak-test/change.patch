diff --git a/test/rename.test.ts b/test/rename.test.ts
new file mode 100644
index 0000000..bd5f5d1
--- /dev/null
+++ b/test/rename.test.ts
@@ -0,0 +1,29 @@
+import { describe, expect, test } from "bun:test";
+import { setup } from "./helpers";
+
+describe("rename", () => {
+  test("renames a note", async () => {
+    const { call, alice } = setup();
+    const note = await (await call("POST", "/notes", alice, { title: "Old" })).json();
+    const res = await call("PATCH", `/notes/${note.id}`, alice, { title: "New" });
+    expect(res.status).toBe(200);
+    const saved = await (await call("GET", `/notes/${note.id}`, alice)).json();
+    expect(saved.title).toBe("New");
+  });
+
+  test("rejects an empty title", async () => {
+    const { call, alice } = setup();
+    const note = await (await call("POST", "/notes", alice, { title: "Keep" })).json();
+    const res = await call("PATCH", `/notes/${note.id}`, alice, { title: "  " });
+    expect(res).toBeDefined();
+    expect(res.status).not.toBe(500);
+  });
+
+  test("does not rename another user's note", async () => {
+    const { call, alice, bob } = setup();
+    const note = await (await call("POST", "/notes", alice, { title: "Mine" })).json();
+    expect((await call("PATCH", `/notes/${note.id}`, bob, { title: "Taken" })).status).toBe(404);
+    const saved = await (await call("GET", `/notes/${note.id}`, alice)).json();
+    expect(saved.title).toBe("Mine");
+  });
+});
